{
  "name": "typosquatwatch",
  "version": "0.1.0",
  "description": "Pre-install dependency supply-chain guard: flags npm/PyPI packages in your manifest that look like typosquats or AI-hallucinated (\"slopsquat\") names of popular packages.",
  "type": "module",
  "license": "MIT",
  "author": "TyposquatWatch contributors",
  "bin": {
    "typosquatwatch": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "npm",
    "pypi",
    "typosquatting",
    "supply-chain",
    "slopsquatting",
    "cli"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^5.0.1"
  }
}
